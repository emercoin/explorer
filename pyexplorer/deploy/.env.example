# Copy to deploy/.env (chmod 600). Read by docker compose --env-file .env.

# Public hostname served by Caddy (Let's Encrypt certificate is issued automatically;
# the DNS record must point at this host and ports 80/443 must be open).
EXPLORER_DOMAIN=explorer3.emercoin.com

# Image tag of ghcr.io/emercoin/explorer to run. deploy-service.sh rewrites this line on
# every release, so the running version is always written down here.
EXPLORER_TAG=latest

# Must equal rpcpassword in deploy/emercoin.conf. openssl rand -hex 32
EMC_RPC_PASSWORD=

# PostgreSQL password for the explorer database. openssl rand -hex 32
POSTGRES_PASSWORD=

# Network switch in the page header; leave empty for none.
# EXPLORER_NETWORKS=mainnet=https://explorer3.emercoin.com,testnet=https://testnet3.emercoin.com

# Run the testnet explorer too (see docker-compose.yaml).
# COMPOSE_PROFILES=testnet
